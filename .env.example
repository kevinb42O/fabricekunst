# Supabase Credentials
# Copy these values from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Server-only variables for Vercel Functions. Never prefix these with VITE_ and
# never expose them to browser code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# `SUPABASE_SERVICE_ROLE_KEY` is also accepted by the server handlers. Set one
# server-only Supabase service key, never both a browser-prefixed variant.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# Analytics v2 and public inquiry protection. Generate two different random
# secrets (at least 32 characters) and set exact production site origins.
ANALYTICS_RATE_LIMIT_SALT=replace-with-a-distinct-random-32-plus-character-secret
ANALYTICS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
INQUIRY_RATE_LIMIT_SALT=replace-with-another-distinct-random-32-plus-character-secret
INQUIRY_ALLOWED_ORIGINS=https://www.example.com,https://example.com
COLLECTOR_LIST_RATE_LIMIT_SALT=replace-with-a-third-distinct-random-32-plus-character-secret
COLLECTOR_LIST_ALLOWED_ORIGINS=https://www.example.com,https://example.com
COLLECTOR_PUBLIC_SITE_URL=https://www.example.com
# Optional: when both values are present, Collector's List uses double opt-in.
RESEND_API_KEY=re_...
COLLECTOR_FROM_EMAIL=Atelier Rembrandt <collectors@example.com>
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@atelierrembrandt.com

# Supabase Management API (Used for Usage Dashboard)
# PAT (Personal Access Token) generated from your Supabase Account Settings
SUPABASE_PAT=sbp_... 
# Project Ref (The unique string in your Supabase project URL: https://[project-ref].supabase.co)
SUPABASE_PROJECT_REF=your-project-ref
