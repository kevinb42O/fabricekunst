{
  "name": "atelier-rembrandt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-r2-config.js && node scripts/generate-llms.js",
    "build": "vite build",
    "postbuild": "node scripts/generate-static-pages.js && node scripts/verify-client-confidentiality.js",
    "sitemap:preview": "node scripts/generate-sitemap.js",
    "content:publish": "node scripts/publish-public-content.js",
    "content:hide-rembrandt": "node scripts/publish-public-content.js --project-hidden",
    "r2:cors": "node scripts/configure-r2-cors.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/functions": "^3.9.5",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.11.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^8.2.2"
  }
